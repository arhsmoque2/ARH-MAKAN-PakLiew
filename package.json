{
  "name": "arh-makan-pakliew",
  "version": "1.0.0",
  "private": true,
  "description": "Pak Liew Chinese Muslim Restaurant PWA - Nanyang Heritage Storefront",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "doctor": "node scripts/quality-gate.mjs",
    "doctor:docs": "node scripts/doctor-docs.mjs",
    "doctor:code": "node scripts/doctor-code.mjs",
    "doctor:ui": "node scripts/doctor-ui.mjs",
    "doctor:render": "node scripts/doctor-render.mjs",
    "doctor:secrets": "node scripts/doctor-secrets.mjs",
    "doctor:edge": "node scripts/doctor-edge.mjs",
    "test": "playwright test",
    "deploy": "wrangler deploy",
    "preview": "node scripts/preview.mjs",
    "ui:probe": "uv run --project D:/_ARH-AGENT-OS/_AGENT-CAPABILITIES/arh-ui-ux-devtool arh-ui-dev probe",
    "ui:hero": "uv run --project D:/_ARH-AGENT-OS/_AGENT-CAPABILITIES/arh-ui-ux-devtool arh-ui-dev hero",
    "ui:image": "uv run --project D:/_ARH-AGENT-OS/_AGENT-CAPABILITIES/arh-ui-ux-devtool arh-ui-dev image",
    "ui:clip": "uv run --project D:/_ARH-AGENT-OS/_AGENT-CAPABILITIES/arh-ui-ux-devtool arh-ui-dev clip",
    "ui:component": "uv run --project D:/_ARH-AGENT-OS/_AGENT-CAPABILITIES/arh-ui-ux-devtool arh-ui-dev component"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}